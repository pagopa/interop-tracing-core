{
  "name": "pagopa-interop-tracing-api",
  "version": "1.0.0",
  "description": "PagoPA tracing api",
  "main": "dist",
  "type": "module",
  "scripts": {
    "test": "vitest run --config ./test/vitest.config.ts",
    "test:it": "vitest run db --config ./test/vitest.config.ts",
    "lint": "eslint .",
    "lint:autofix": "eslint . --fix",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "start": "node --watch --no-warnings --loader ts-node/esm -r 'dotenv-flow/config' ./src/index.ts",
    "build": "tsc",
    "check": "tsc --project tsconfig.check.json",
    "generate-model": "mkdir -p ./src/model/generated && pnpm openapi-zod-client './open-api/api-external-interop-v1.yaml' -o './src/model/generated/api.ts' && node --no-warnings --loader ts-node/esm ./multerPatchZodios.ts",
    "clean-generated": "pnpm exec rm ./src/model/generated/api.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/dotenv-flow": "3.3.3",
    "@types/express": "4.17.17",
    "@types/node": "20.14.1",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "8.22.0",
    "@typescript-eslint/parser": "8.22.0",
    "eslint": "9.18.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-prettier": "5.0.0",
    "globals": "15.14.0",
    "prettier": "3.0.3",
    "supertest": "6.3.4",
    "ts-node": "10.9.2",
    "typescript": "5.5.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.887.0",
    "@tsconfig/node-lts": "20.1.0",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "2.2.0",
    "@zodios/core": "10.9.6",
    "@zodios/express": "10.6.1",
    "@zodios/plugins": "10.6.0",
    "axios": "1.16.0",
    "dotenv-flow": "3.3.0",
    "express": "4.20.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.1.0",
    "multer": "2.2.0",
    "openapi-zod-client": "1.18.1",
    "pagopa-interop-tracing-commons": "workspace:*",
    "pagopa-interop-tracing-models": "workspace:*",
    "pagopa-interop-tracing-operations-client": "workspace:*",
    "ts-pattern": "5.4.0",
    "uuid": "11.1.1",
    "zod": "3.23.8"
  }
}